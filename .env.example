# n8n Configuration
N8N_URL=http://localhost:5678
N8N_WEBHOOK_URL=http://localhost:5678/webhook

# FastAPI Configuration
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8000
API_KEY=dev-key

# Data Directory
DATA_DIR=./data
BROWSER_PROFILE_DIR=./data/browser-profile

# Automation Settings
DELAY_MIN_MS=150
DELAY_MAX_MS=750
FILL_AHEAD_BUFFER=3
HEADLESS=false

# Per-domain rate limits (JSON)
RATE_LIMITS={"greenhouse.io": 5, "default": 5}

# Gemini AI (for custom question fallback)
GEMINI_API_KEY=
